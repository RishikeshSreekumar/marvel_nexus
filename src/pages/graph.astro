---
import MarvelNexus from "../components/MarvelNexus";
import "../styles/global.css";

const title = "Dependency Graph — Marvel Nexus";
const description = "Trace every MCU story prerequisite and build your path to a Marvel destination.";
const canonical = new URL("/graph", Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070b" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body><MarvelNexus page="graph" client:load /></body>
</html>
